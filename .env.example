# ---- Required ----
# Login credentials for the single user
NUXT_APP_USERNAME=change-me
NUXT_APP_PASSWORD=change-me

# Session encryption secret (at least 32 random characters)
NUXT_SESSION_PASSWORD=please-change-me-to-a-random-32-plus-character-string

# Postgres connection string.
# Supabase: Project Settings → Database → Connection string → URI (Transaction pooler, port 6543)
NUXT_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/jlpt

# ---- AI (needed for generating questions / passages / explanations) ----
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_MODEL=gpt-5.4-mini
NUXT_MONTHLY_BUDGET_USD=5

# ---- Cron (Vercel Cron calls /api/cron/daily with Authorization: Bearer <secret>) ----
NUXT_CRON_SECRET=

# ---- Public ----
NUXT_PUBLIC_EXAM_DATE=2026-12-06
